# Where the scraper pushes listings. Copy this file to backend/.env and fill
# both in; convex_push.py skips the push entirely if either is missing, so
# the scraper still runs locally without them.

# The deployment URL `npx convex dev` wrote into frontend/.env.local as
# NEXT_PUBLIC_CONVEX_URL. Either host works -- Convex serves queries from
# .convex.cloud and HTTP actions from .convex.site, and convex_push.py
# converts one to the other for you.
CONVEX_URL=https://your-deployment-123.convex.cloud

# This machine's own key. It must appear in the list Convex holds:
#   npx convex env set POLLER_SECRET <key>              (one machine)
#   npx convex env set POLLER_SECRET <keyA>,<keyB>      (several)
#
# Convex accepts a comma-separated list so each machine feeding a deployment
# carries its own key. Handing someone a copy of yours means you cannot cut
# them off later without rotating it for everybody; give them their own entry
# and you revoke it by deleting that entry alone.
#
# Generate one with:  openssl rand -hex 32
POLLER_SECRET=
