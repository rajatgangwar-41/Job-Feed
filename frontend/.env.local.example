# Copy to frontend/.env.local. Both files are gitignored (.env* is covered in
# frontend/.gitignore and the root .gitignore) -- keep it that way.

# --- Convex --------------------------------------------------------------
# `npx convex dev` writes these two itself the first time you run it. You
# should not need to type them by hand.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Clerk ---------------------------------------------------------------
# Clerk dashboard -> API keys. The publishable key is public by design (it
# ships to the browser); the secret key must never leave this file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends people after auth. The modal sign-in already passes
# these explicitly, so they are only a fallback.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
